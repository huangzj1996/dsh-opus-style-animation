{
  "name": "dsh-style-cards",
  "version": "0.1.0",
  "private": true,
  "description": "风格卡片启动器：DSH 左侧栏底部入口 + 浮层卡片墙（v1 只装本机 profile）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node scripts/build.mjs && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "mode": "patch",
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
